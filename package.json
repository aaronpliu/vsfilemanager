{
  "name": "vsfilemanager",
  "publisher": "aaronpliu",
  "displayName": "VS File Manager",
  "description": "Advanced JSON, YAML, XML, and TOML structure editor with file synchronization",
  "version": "1.3.3",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "json",
    "yaml",
    "xml",
    "toml",
    "editor",
    "block",
    "sync",
    "batch",
    "file manager"
  ],
  "icon": "media/icons/icon-128.png",
  "galleryBanner": {
    "color": "#4285f4",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:yaml",
    "onLanguage:yml",
    "onLanguage:xml",
    "onLanguage:toml"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsfilemanager.editStructuredBlocks",
        "title": "Edit Structured Blocks"
      },
      {
        "command": "vsfilemanager.syncFiles",
        "title": "Sync Structured Files"
      },
      {
        "command": "vsfilemanager.batchUpdate",
        "title": "Batch Update Structured Files"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "resourceExtname == .json || resourceExtname == .yaml || resourceExtname == .yml || resourceExtname == .xml || resourceExtname == .toml",
          "command": "vsfilemanager.editStructuredBlocks",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js",
    "test:unit": "jest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "git add"
    ]
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^8.33.0",
    "glob": "^8.1.0",
    "husky": "^9.0.0",
    "jest": "^30.2.0",
    "lint-staged": "^15.0.0",
    "mocha": "^10.1.0",
    "ts-jest": "^29.4.5",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "fast-xml-parser": "^4.2.5",
    "js-yaml": "^4.1.0",
    "toml": "^3.0.0",
    "tomlify-j0.4": "^3.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aaronpliu/vsfilemanager.git"
  },
  "bugs": {
    "url": "https://github.com/aaronpliu/vsfilemanager/issues"
  },
  "homepage": "https://github.com/aaronpliu/vsfilemanager/blob/main/README.md",
  "license": "MIT"
}