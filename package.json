{
  "name": "vsfilemanager",
  "displayName": "VS File Manager",
  "description": "Advanced JSON structure editor with file synchronization",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsfilemanager.editJsonBlocks",
        "title": "Edit JSON Blocks"
      },
      {
        "command": "vsfilemanager.syncFiles",
        "title": "Sync JSON Files"
      },
      {
        "command": "vsfilemanager.batchUpdate",
        "title": "Batch Update JSON Files"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "eslint": "^8.33.0",
    "glob": "^8.1.0",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4",
    "@vscode/test-electron": "^2.2.0"
  }
}