{
  "name": "vsfilemanager",
  "publisher": "aaronpliu",
  "displayName": "VS File Manager",
  "description": "Advanced JSON and YAML structure editor with file synchronization",
  "version": "0.0.5",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "json",
    "yaml",
    "editor",
    "block",
    "sync",
    "batch",
    "file manager"
  ],
  "icon": "media/icons/icon-128.png",
  "galleryBanner": {
    "color": "#4285f4",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:json",
    "onLanguage:yaml",
    "onLanguage:yml"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vsfilemanager.editJsonBlocks",
        "title": "Edit JSON/YAML Blocks"
      },
      {
        "command": "vsfilemanager.syncFiles",
        "title": "Sync JSON/YAML Files"
      },
      {
        "command": "vsfilemanager.batchUpdate",
        "title": "Batch Update JSON/YAML Files"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@vscode/test-electron": "^2.2.0",
    "@vscode/vsce": "^3.6.2",
    "eslint": "^8.33.0",
    "glob": "^8.1.0",
    "mocha": "^10.1.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aaronpliu/vsfilemanager.git"
  },
  "bugs": {
    "url": "https://github.com/aaronpliu/vsfilemanager/issues"
  },
  "homepage": "https://github.com/aaronpliu/vsfilemanager/blob/main/README.md",
  "license": "MIT"
}
